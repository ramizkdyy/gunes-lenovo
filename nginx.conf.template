server {
  listen ${PORT};
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Angular çıktısındaki js/css dosya adları hash'li, uzun süre önbelleklenebilir.
  location ~* \.(js|css)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  # SPA: bilinmeyen yollar index.html'e düşer, yönlendirmeyi Angular yapar.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
